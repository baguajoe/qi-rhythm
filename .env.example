# ---- Backend ----
APP_CONFIG=default
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=postgresql+psycopg://qi:qi@localhost:5432/qi_rhythm
TEST_DATABASE_URL=postgresql+psycopg://qi:qi@localhost:5432/qi_rhythm_test
CORS_ORIGINS=http://localhost:5173
JWT_ACCESS_HOURS=12
DISPLAY_TOKEN_MINUTES=15
# threading for `python wsgi.py`; gevent in production (gunicorn.conf.py)
SOCKETIO_ASYNC_MODE=threading
AUDIO_WARMUP=1
RECORDING_RETENTION_DAYS=7
# Dev-only demo account created by `flask --app wsgi seed --demo`
DEMO_EMAIL=demo@example.com
DEMO_PASSWORD=rhythm-demo-123

# Storage: local (dev) or r2
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=qi-rhythm-recordings

# ---- Frontend (Vite) ----
VITE_API_URL=http://localhost:5000
